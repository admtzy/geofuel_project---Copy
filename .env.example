# Salin menjadi .env dan ubah setelah koordinat terminal diverifikasi.
GEOFUEL_TERMINAL_NAME=Fuel Terminal (isi nama resmi)
GEOFUEL_TERMINAL_LAT=-6.9158
GEOFUEL_TERMINAL_LON=107.7036
GEOFUEL_OSM_RADIUS_M=10000
GEOFUEL_TERMINAL_INITIAL_STOCK_LITERS=180000
# Opsional: ganti sumber CSV
# GEOFUEL_STATION_CSV=data/stations_actual.csv
# GEOFUEL_FLEET_CSV=data/fleet_actual.csv

# Status hanya boleh ACTUAL_VERIFIED bila identitas/koordinat sudah diverifikasi.
GEOFUEL_TERMINAL_DATA_STATUS=UNVERIFIED
GEOFUEL_TERMINAL_STOCK_STATUS=SIMULATED
GEOFUEL_MAX_SNAP_DISTANCE_M=1500
